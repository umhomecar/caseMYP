# Supabase project used by this deployment.
# Vercel Preview must use the isolated umMYP-staging project.
# Keep Preview and Production values separate in Vercel.
# Never put a service_role or secret key in browser runtime configuration.
CASEMYP_SUPABASE_URL=https://your-project-ref.supabase.co
CASEMYP_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Keep "legacy" until every active public.users row has a linked auth_user_id.
# Switch to "supabase" only after the guarded Auth/RLS production migration passes.
CASEMYP_AUTH_MODE=legacy
